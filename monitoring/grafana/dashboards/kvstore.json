{
  "uid": "kvstore-live",
  "title": "KVStore live",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Telemetry",
      "description": "Prometheus scrape status and presence of the operation counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "((up{job=\"kvstore\"} == 1) and on(job,instance) kvstore_operations_total{job=\"kvstore\"}) or (up{job=\"kvstore\"} * 0) or (absent(up{job=\"kvstore\"}) * 0)",
          "legendFormat": "Scrape",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Telemetry missing",
                  "color": "red"
                },
                "1": {
                  "text": "Scraping",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alert state",
      "description": "Prometheus alert rules evaluated locally. 0 means there are no active rules while Prometheus is serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"KVStore.*\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "count(ALERTS{alertname=~\"KVStore.*\",alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "Pending",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "text",
      "title": "Shard health",
      "description": "The current storage engine has no separate shard availability states.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Independent shard availability is unavailable in this engine."
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Completed data operations",
      "description": "Successes and lookup misses per second. The selected window applies to rates and histograms.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"$operation\",operation!~\"compact|recovery\",outcome=~\"ok|miss\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed operations and lookup misses",
      "description": "Shown separately so expected misses are visible without increasing error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"$operation\",operation!~\"compact|recovery\",outcome=~\"error|miss\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failure rate",
      "description": "Failed data operations divided by all attempts. Idle operations have no rate ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(operation) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"$operation\",operation!~\"compact|recovery\",outcome=\"error\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / sum by(operation) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"$operation\",operation!~\"compact|recovery\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Operation latency",
      "description": "Wall time for attempted calls, including expected misses and errors. Quantiles interpolate within histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)))",
          "legendFormat": "p50 \u00b7 {{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)))",
          "legendFormat": "p95 \u00b7 {{operation}}",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)))",
          "legendFormat": "p99 \u00b7 {{operation}}",
          "instant": false,
          "range": true,
          "refId": "C"
        },
        {
          "expr": "sum by(operation) (rate(kvstore_operation_duration_seconds_sum{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / sum by(operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "Mean \u00b7 {{operation}}",
          "instant": false,
          "range": true,
          "refId": "D"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency samples",
      "description": "Attempted operation samples in the selected rolling window.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(operation) (increase(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"$operation\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Maintenance activity",
      "description": "Compaction and startup/recovery completions, separated from data throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"compact|recovery\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WAL sync calls",
      "description": "Completed WAL sync calls per second, with retries on EINTR counted as one logical call.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(phase,outcome) (rate(kvstore_wal_syncs_total{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{phase}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WAL sync latency",
      "description": "p95 and mean include successful and failed sync calls. Parent-directory sync is outside this measurement.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(phase,le) (rate(kvstore_wal_sync_duration_seconds_bucket{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)))",
          "legendFormat": "p95 \u00b7 {{phase}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum by(phase) (rate(kvstore_wal_sync_duration_seconds_sum{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / sum by(phase) (rate(kvstore_wal_sync_duration_seconds_count{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "Mean \u00b7 {{phase}}",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "WAL and compaction writes",
      "description": "Bytes accepted by write calls, including bytes later rolled back. Compaction bytes are serialized output.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(source) (rate(kvstore_storage_written_bytes_total{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Disk space",
      "description": "Logical database file length (WAL, lock and temporary compaction WAL), active WAL length and filesystem space available to the CLI.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "kvstore_wal_file_bytes{job=\"kvstore\"} and on(job,instance) (up{job=\"kvstore\"} == 1)",
          "legendFormat": "WAL bytes",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "kvstore_database_file_bytes{job=\"kvstore\"} and on(job,instance) (up{job=\"kvstore\"} == 1)",
          "legendFormat": "Database file bytes",
          "instant": false,
          "range": true,
          "refId": "C"
        },
        {
          "expr": "kvstore_filesystem_available_bytes{job=\"kvstore\"} and on(job,instance) (up{job=\"kvstore\"} == 1)",
          "legendFormat": "Available filesystem bytes",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Process CPU",
      "description": "Fraction of one CPU core used by the CLI and exporter. Can exceed 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "rate(kvstore_process_cpu_seconds_total{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)",
          "legendFormat": "Process",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Process peak RSS",
      "description": "Process high-water mark from getrusage.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "kvstore_process_peak_rss_bytes{job=\"kvstore\"} and on(job,instance) (up{job=\"kvstore\"} == 1)",
          "legendFormat": "Peak RSS",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Active alerts",
      "description": "Alert names and pending or firing states from Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"KVStore.*\"}",
          "legendFormat": "{{alertname}} \u00b7 {{alertstate}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "operation",
        "label": "Operation",
        "type": "custom",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "query": "get,set,set_ttl,delete,size,range,compact,recovery",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "window",
        "label": "Rate window",
        "type": "interval",
        "query": "30s,1m,5m,15m",
        "current": {
          "text": "1m",
          "value": "1m"
        }
      }
    ]
  }
}
