{
  "uid": "kvstore-live",
  "title": "KVStore live",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Telemetry",
      "description": "Prometheus scrape status and presence of the operation counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "(max((up{job=\"kvstore\"} == 1) and on(job,instance) kvstore_operations_total{job=\"kvstore\"}) or vector(0))",
          "legendFormat": "Scrape",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Telemetry missing",
                  "color": "red"
                },
                "1": {
                  "text": "Scraping",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 17,
      "title": "Data throughput",
      "description": "Successful operations and expected lookup misses per second.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(kvstore_operations_total{job=\"kvstore\",operation=~\"get|set|set_ttl|delete|size|range\",outcome=~\"ok|miss\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "Throughput",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "id": 18,
      "title": "p99 latency",
      "description": "Pooled data-operation p99 for the selected rate window.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"get|set|set_ttl|delete|size|range\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum(rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"get|set|set_ttl|delete|size|range\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p99",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "id": 19,
      "title": "Error rate",
      "description": "Failed data operations as a fraction of attempts.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(kvstore_operations_total{job=\"kvstore\",operation=~\"get|set|set_ttl|delete|size|range\",outcome=\"error\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / (sum(rate(kvstore_operations_total{job=\"kvstore\",operation=~\"get|set|set_ttl|delete|size|range\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "Errors",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alert state",
      "description": "Prometheus alert rules evaluated locally. 0 means there are no active rules while Prometheus is serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"KVStore.*\",alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Firing",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "count(ALERTS{alertname=~\"KVStore.*\",alertstate=\"pending\"}) or vector(0)",
          "legendFormat": "Pending",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 20,
      "title": "Operations",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Completed data operations",
      "description": "Completions per second by operation and outcome. Expected lookup misses are completed reads.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"${operation:regex}\",operation=~\"get|set|set_ttl|delete|size|range\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} · {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · error$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · miss$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Operation latency",
      "description": "Wall time for attempted calls, including expected misses and errors. Quantiles interpolate within histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p50 · {{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p95 · {{operation}}",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p99 · {{operation}}",
          "instant": false,
          "range": true,
          "refId": "C"
        },
        {
          "expr": "sum by (operation) (rate(kvstore_operation_duration_seconds_sum{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "Mean · {{operation}}",
          "instant": false,
          "range": true,
          "refId": "D"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed operations and lookup misses",
      "description": "Shown separately so expected misses are visible without increasing error rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"${operation:regex}\",operation=~\"get|set|set_ttl|delete|size|range\",outcome=~\"error|miss\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} · {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · error$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · miss$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failure rate",
      "description": "Failed data operations divided by all attempts. Idle operations have no rate ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"${operation:regex}\",operation=~\"get|set|set_ttl|delete|size|range\",outcome=\"error\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / (sum by (operation) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"${operation:regex}\",operation=~\"get|set|set_ttl|delete|size|range\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency samples",
      "description": "Attempted operation samples in the selected rolling window.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(operation) (increase(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=~\"${operation:regex}\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Active alerts",
      "description": "Alert names and pending or firing states from Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"KVStore.*\"}",
          "legendFormat": "{{alertname}} · {{alertstate}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · firing$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · pending$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "Storage",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "WAL sync calls",
      "description": "Completed WAL sync calls per second, with retries on EINTR counted as one logical call.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by(phase,outcome) (rate(kvstore_wal_syncs_total{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{phase}} · {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · error$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · miss$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WAL sync latency",
      "description": "Mean and p95 of WAL file sync calls. These include failed syncs.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(phase,le) (rate(kvstore_wal_sync_duration_seconds_bucket{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)))",
          "legendFormat": "p95 · {{phase}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "sum by(phase) (rate(kvstore_wal_sync_duration_seconds_sum{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / sum by(phase) (rate(kvstore_wal_sync_duration_seconds_count{job=\"kvstore\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "Mean · {{phase}}",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Maintenance activity",
      "description": "Explicit compact calls, individual nonempty shard flushes and startup/recovery completions.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation,outcome) (rate(kvstore_operations_total{job=\"kvstore\",operation=~\"compact|flush|recovery\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))",
          "legendFormat": "{{operation}} · {{outcome}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "custom": {
            "spanNulls": false,
            "showPoints": "never",
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic-by-name"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · error$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ · miss$/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
