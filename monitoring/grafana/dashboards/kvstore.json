      "id": 23,
      "type": "timeseries",
      "title": "Sorted-table lookup latency",
      "description": "Point lookup time across immutable sorted tables, excluding time waiting for the disk-read mutex. Includes misses and errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "kvstore-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (operation) (rate(kvstore_operation_duration_seconds_sum{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) / (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "Mean",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (operation,le) (rate(kvstore_operation_duration_seconds_bucket{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1))) and (sum by (operation) (rate(kvstore_operation_duration_seconds_count{job=\"kvstore\",operation=\"disk_lookup\"}[$window]) and on(job,instance) (up{job=\"kvstore\"} == 1)) > 0)",
          "legendFormat": "p99",
          "instant": false,
          "range": true,
          "refId": "C"
        }
